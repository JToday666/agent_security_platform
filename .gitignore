# IDE
.vscode/
!.vscode/extensions.json
.idea/

# Editor and system files
*.sw?
~$*
.DS_Store

# Local environment files
**/.env*
!**/.env.example
!**/.env.*.example

# Deployment runtime files
/deploy/nginx/logs/
/deploy/nginx/certs/
/deploy/nginx/acme/
/deploy/nginx/html/
/var/log/
/var/backend/

# Docker compose local overrides
docker-compose*.override.yml
docker-compose*.local.yml
docker-compose*.prod.yml
!docker-compose*.example.yml
!docker-compose*.prod.example.yml

# Python virtual environments
.venv/

# Project tooling
.github/
AGENTS.md
.codex/
.worktrees/
.superpowers/

# Data files
/data/

# backend
/backend/runtime/
/backend/data/**
!/backend/data/agent_runtime_shared/
!/backend/data/agent_runtime_shared/**
/backend/.coverage
/backend/.pytest_cache/
/backend/**/__pycache__/

# Frontend environment files
/frontend/.env
!/frontend/.env.example

# Frontend dependencies and caches
/frontend/node_modules/
/frontend/.vite/
/frontend/.eslintcache
/frontend/*.tsbuildinfo
/frontend/*.timestamp-*-*.mjs

# Frontend build and test outputs
/frontend/dist/
/frontend/dist-ssr/
/frontend/coverage/
/frontend/playwright-report/
/frontend/test-results/
/frontend/cypress/videos/
/frontend/cypress/screenshots/
/frontend/*.local
/__screenshots__/

# Logs
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

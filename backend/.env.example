PROJECT_NAME="Project Name"

FASTAPI_PORT=8000
FASTAPI_HOST=127.0.0.1

# Optional full SQLAlchemy database URL. When set, it takes precedence over
# POSTGRES_* and the backend normalizes the async/sync driver per call site.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db_name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxxxx

SQLALCHEMY_ECHO=false

# Storage roots. Defaults are derived from ASP_DATA_ROOT so code and data stay separate.
ASP_DATA_ROOT=/data/agent-security-platform
# DATASET_ROOT_DIR=/data/agent-security-platform/data/datasets
# DATASET_METADATA_ROOT_DIR=/data/agent-security-platform/data/dataset-registry
# UPLOAD_ROOT_DIR=/data/agent-security-platform/data/uploads
# RUNTIME_ROOT_DIR=/data/agent-security-platform/runtime
# TMP_ROOT_DIR=/data/agent-security-platform/tmp
# LOG_ROOT_DIR=/data/agent-security-platform/logs
DATASET_ROOT_DIR=
DATASET_METADATA_ROOT_DIR=
UPLOAD_ROOT_DIR=
RUNTIME_ROOT_DIR=
TMP_ROOT_DIR=
LOG_ROOT_DIR=

# OpenAI-compatible LLM gateway
LLM_BASE_URL=http://127.0.0.1:18400/v1
LLM_DEFAULT_MODEL=local-qwen
LLM_API_KEY=

# LLM judge overrides
LLM_JUDGE_PROVIDER=litellm
LLM_JUDGE_BASE_URL=
LLM_JUDGE_MODEL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_TIMEOUT_SECONDS=60.0
LLM_JUDGE_MAX_TOKENS=2000
LLM_JUDGE_TEMPERATURE=0.0
LLM_JUDGE_MAX_EVENTS=160
